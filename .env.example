# Supabase > Project Settings > Database > Connection string
# URL do pooler (Transaction mode, porta 6543) usada pelo app
DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# URL direta (Session mode, porta 5432) usada para aplicar migrações
DIRECT_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# Segredo para assinar a sessão de login (gere uma string aleatória longa)
AUTH_SECRET=troque-por-uma-string-aleatoria-longa
